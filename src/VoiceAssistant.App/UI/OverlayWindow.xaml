<Window x:Class="VoiceAssistant.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Assistant"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Pill"
            CornerRadius="18"
            Background="#E6202124"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14,8"
            MaxWidth="560">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/logo-64.png" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#9AA0A6" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ModeText" Foreground="White" FontSize="13" FontWeight="SemiBold" Text="Starting…" />
                    <Border x:Name="LanguageBadge" Visibility="Collapsed" Background="#334C8DF6" CornerRadius="6" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Dictation is in Hindi + English (Alt+Shift+H switches back to English)">
                        <TextBlock Text="HI + EN" Foreground="#C6DAFC" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="PlaceText" Foreground="#8AB4F8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="500" Margin="0,1,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="LiveText" Foreground="#E8EAED" FontSize="13" TextWrapping="Wrap" MaxWidth="440" MaxHeight="56" Margin="0,3,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" Foreground="#E8EAED" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="500" Visibility="Collapsed" />
                <TextBlock x:Name="HeardText" Foreground="#9AA0A6" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="500" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="MinimizeButton" Focusable="False" Cursor="Hand" VerticalAlignment="Top" Margin="10,-2,-4,0"
                    ToolTip="Hide until needed (it reappears when you dictate or say “Hey Jarvis”). Show it again from the tray icon.">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="20" Height="20" CornerRadius="10" Background="Transparent">
                            <TextBlock Text="–" Foreground="#9AA0A6" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
