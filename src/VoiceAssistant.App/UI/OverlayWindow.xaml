<Window x:Class="VoiceAssistant.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Assistant"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Pill"
            CornerRadius="18"
            Background="#E6202124"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14,8"
            MaxWidth="560">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#9AA0A6" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ModeText" Foreground="White" FontSize="13" FontWeight="SemiBold" Text="Starting…" />
                <TextBlock x:Name="MessageText" Foreground="#E8EAED" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="500" Visibility="Collapsed" />
                <TextBlock x:Name="HeardText" Foreground="#9AA0A6" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="500" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
